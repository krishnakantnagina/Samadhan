# Copy this file to .env and fill in real values. Never commit .env.

SARVAM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # live-checked 27 Sep (S05 G-S05-2); JSON mode works on all Groq models
GEMINI_MODEL=gemini-3.6-flash        # live-checked 27 Sep; gemini-3.7/3.8-flash returned 503s under load, re-check before demo
SUPABASE_URL=
SUPABASE_SERVICE_KEY=     # backend AND dashboard -- both are server-side (S13); never in the front end
SUPABASE_ANON_KEY=        # RLS + revoked grants = zero table access (verified live, T06); no component uses it today
SUPABASE_DB_URL=          # one-time deploy credential only (psql -f database/schema.sql); the app itself never reads this
LLM_PROVIDER=groq         # or gemini; groq is primary per PROJECT.md section 6
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500   # comma-separated website origins allowed by CORS; 5500 = frontend's http.server port (PROJECT.md section 7)
DASHBOARD_PASSWORD=       # shared officer password (S13 G-S13-1) -- pick a real value locally, share with the team, never commit it
