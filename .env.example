# Copy this file to .env and fill in real values. Never commit .env.

SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4               # S12; Saarika is being deprecated by Sarvam, saaras:v4 mode=transcribe is current
SARVAM_TTS_MODEL=bulbul:v3           # S17; live-checked 28 Sep 2026, docs.sarvam.ai
SARVAM_TTS_SPEAKER=shubh             # S17 G-S17-2; Sarvam's own documented default, PROPOSED -- swap freely
GROQ_WHISPER_MODEL=whisper-large-v3-turbo   # S12 ASR fallback; separate model from GROQ_MODEL (that one's for the Turn Engine)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b       # live-checked 28 Sep; llama-3.1/3.3 models were retired from Groq's lineup, re-check before demo
GEMINI_MODEL=gemini-3.6-flash        # live-checked 27 Sep; gemini-3.7/3.8-flash returned 503s under load, re-check before demo
SUPABASE_URL=
SUPABASE_SERVICE_KEY=     # backend AND dashboard -- both are server-side (S13); never in the front end
SUPABASE_ANON_KEY=        # RLS + revoked grants = zero table access (verified live, T06); no component uses it today
SUPABASE_DB_URL=          # one-time deploy credential only (psql -f database/schema.sql); the app itself never reads this
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b   # S26: extra Groq models tried after GROQ_MODEL, each has its own quota; empty = none. Measured 29 Sep
GROQ_REASONING_EFFORT=low            # S26: low|medium|high, sent to openai/gpt-oss-* only; empty = omit. low was ~25% faster, same accuracy
LLM_PROVIDER=groq         # or gemini; groq is primary per PROJECT.md section 6
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:3000,http://127.0.0.1:5500   # comma-separated website origins allowed by CORS; 5500 = frontend's http.server port (PROJECT.md section 7)
DASHBOARD_PASSWORD=       # shared officer password (S13 G-S13-1) -- pick a real value locally, share with the team, never commit it

# S30 intake v2 (Jev decides the department; off unless INTAKE_V2=1 AND a key is set)
INTAKE_V2=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=

# S31 registration (off unless AUTH_PROVIDER is set). demo = any phone + fixed PIN 5555: NEVER for real citizens; refused on a production host.
# Apply database/migrations/002 BEFORE enabling in a deployed environment.
AUTH_PROVIDER=            # demo (later: the real OTP provider's name)
AUTH_REQUIRED=            # 1 = a complaint can only be filed by a logged-in citizen
AUTH_IDLE_DAYS=30         # saved login expires after this many idle days
AUTH_MAX_DAYS=90          # ...and never lives longer than this
AUTH_DEMO_IN_PRODUCTION=  # set to 1 only on purpose

# S32 audio reader (Gemini first, load-protected). Off unless ASR_PIPELINE=router; empty/legacy = Sarvam then Whisper as before.
# Use a PAID Gemini key for citizen voice (free-tier content may be used by Google to improve products).
ASR_PIPELINE=             # router | legacy (default)
ASR_PROVIDERS=gemini,sarvam   # preference order; add whisper only as a last resort (gibberish on dialect Hindi)
GEMINI_ASR_MODELS=        # comma list tried in order, each model has its own daily quota, e.g. gemini-3.8-flash,gemini-3.1-flash-lite,gemini-3-flash-preview
GEMINI_ASR_MODEL=         # single model (used when the list is empty); empty = GEMINI_MODEL
ASR_GEMINI_RPM=600        # requests per minute this server may send to Gemini (set to your quota; 0 = unlimited)
ASR_SARVAM_RPM=300
ASR_MAX_CONCURRENCY=32    # in-flight calls per provider
ASR_MIN_CONFIDENCE=0.5    # below this the citizen is asked to repeat
ASR_BUDGET_SECONDS=20     # total time one voice turn may spend reading audio
ASR_MAX_ATTEMPTS=2        # per provider (1 = no retry)
ASR_BREAKER_THRESHOLD=5   # consecutive failed requests before a provider is skipped
ASR_BREAKER_COOLDOWN=30   # seconds before one probe call
ASR_PERMANENT_COOLDOWN=300  # seconds after "no credit" / bad key
ASR_MAX_QUEUE_WAIT=2      # seconds to wait for a rate-limit token before using the next provider
ASR_SARVAM_LANGUAGE=hi-IN

# S32 spoken replies. Empty/sarvam = Sarvam only (as before). sarvam,gemini = Gemini speech takes over when Sarvam fails (no credit, errors).
TTS_PROVIDERS=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# S33 triage questions (rides on INTAKE_V2: needs Jev + the Turn Engine's LLM). Off unless TRIAGE=1 and a bank folder exists.
TRIAGE=                       # 1 = after the story is clear, ask up to TRIAGE_MAX_QUESTIONS questions (who, how bad)
TRIAGE_BANK_DIR=              # folder of per-department JSON (default specs/triage). Drafts live in local-research/question-bank (git-excluded)
TRIAGE_MAX_QUESTIONS=3        # per complaint; place and duration are asked by the existing steps, not counted here

# S36 scheme lookup (RAG): an information question gets matching scheme names + official CM Helpline links. Off unless 1.
SCHEME_LOOKUP=               # 1 = RAG over specs/registry/schemes_index.json (needs GEMINI_API_KEY; rebuild the index after editing schemes.csv)
SCHEME_RERANK=               # 1 = let Gemini pick the best of the top 6 (slower, off by default)
